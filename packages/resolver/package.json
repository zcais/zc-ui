{
  "name": "@zc-ui/resolver",
  "version": "1.0.2",
  "description": "ZC UI resolver for unplugin-vue-components and unplugin-auto-import",
  "license": "MIT",
  "author": "ZC UI Team",
  "homepage": "https://zcais.github.io/zc-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zcais/zc-ui.git",
    "directory": "packages/resolver"
  },
  "bugs": {
    "url": "https://github.com/zcais/zc-ui/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "ui",
    "resolver",
    "unplugin",
    "auto-import",
    "zc-ui"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  }
}
