exports[`Dark mode: component snapshots > ErrorBoundary error state renders correctly under .dark 1`] = `
"<div data-v-d40bfdc5="" class="zc-error-boundary" role="alert" aria-live="polite">
  <!-- Custom error slot -->
  <div data-v-d40bfdc5="" class="zc-error-boundary__content">
    <!-- Icon -->
    <div data-v-d40bfdc5="" class="zc-error-boundary__icon" aria-hidden="true"><svg data-v-d40bfdc5="" viewBox="0 0 64 64" width="56" height="56" fill="none">
        <circle data-v-d40bfdc5="" cx="32" cy="32" r="28" stroke="currentColor" stroke-width="3" opacity="0.15"></circle>
        <path data-v-d40bfdc5="" d="M32 18v16" stroke="currentColor" stroke-width="4" stroke-linecap="round"></path>
        <circle data-v-d40bfdc5="" cx="32" cy="44" r="3" fill="currentColor"></circle>
      </svg></div><!-- Title -->
    <div data-v-d40bfdc5="" class="zc-error-boundary__title">Something went wrong</div><!-- Description -->
    <!--v-if-->
    <!-- Action -->
    <div data-v-d40bfdc5="" class="zc-error-boundary__action"><button data-v-d40bfdc5="" type="button" class="zc-error-boundary__retry-btn">重试</button></div><!-- Details (collapsible) -->
    <div data-v-d40bfdc5="" class="zc-error-boundary__details"><button data-v-d40bfdc5="" type="button" class="zc-error-boundary__details-toggle">▸ 错误详情</button>
      <!--v-if-->
    </div>
  </div>
</div>"
`;

