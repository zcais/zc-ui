{
  "name": "@zc-ui/hooks",
  "version": "1.0.0",
  "description": "ZC UI Vue 3 composables / hooks",
  "license": "MIT",
  "author": "ZC UI Team",
  "homepage": "https://zcais.github.io/zc-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zcais/zc-ui.git",
    "directory": "packages/hooks"
  },
  "bugs": {
    "url": "https://github.com/zcais/zc-ui/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "hooks",
    "composables",
    "zc-ui"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@zc-ui/utils": "workspace:*",
    "@zc-ui/locale": "workspace:*"
  }
}
