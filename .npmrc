# ──────────────────────────────────────────────────────────────
# ZC UI — npm configuration
# Only npm-compatible settings here. pnpm-specific settings
# live in `package.json` under the "pnpm" key.
# ──────────────────────────────────────────────────────────────

# Registry
registry=https://registry.npmjs.org/

# Publish settings
access=public

# Install behavior
save-exact=false
fund=false
audit-level=moderate
