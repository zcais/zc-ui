{
  "name": "zc-ui",
  "version": "0.0.1",
  "private": true,
  "description": "ZC UI Component Library - Monorepo",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm -C docs dev",
    "build": "pnpm -r --filter=./packages/* run build",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write \"**/*.{js,ts,json,vue,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,json,vue,md}\"",
    "typecheck": "vue-tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:chromium": "playwright test --project=chromium",
    "e2e:firefox": "playwright test --project=firefox",
    "e2e:webkit": "playwright test --project=webkit",
    "e2e:update-snapshots": "playwright test --update-snapshots",
    "e2e:report": "playwright show-report",
    "prepare": "husky",
    "clean": "pnpm -r exec rimraf dist && rimraf node_modules",
    "bundle-size": "node scripts/check-bundle-size.mjs",
    "bundle-size:update": "node scripts/check-bundle-size.mjs --update",
    "bundle-size:report": "node scripts/check-bundle-size.mjs --report",
    "build:analyze": "cross-env ANALYZE=true pnpm build",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "pnpm build && changeset publish",
    "changeset:publish:otp": "pnpm build && changeset publish -- --otp",
    "docs:dev": "pnpm -C docs dev",
    "docs:build": "pnpm build && pnpm -C docs build",
    "docs:preview": "pnpm -C docs preview",
    "gen:icons": "node scripts/gen-icons-manifest.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@changesets/cli": "^2.27.0",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.9.3",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.8",
    "@vue/test-utils": "^2.4.11",
    "axe-core": "^4.12.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.28.0",
    "globals": "^15.0.0",
    "husky": "^9.1.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^15.2.0",
    "prettier": "^3.3.0",
    "qrcode": "^1.5.4",
    "rimraf": "^6.0.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.0.2",
    "vitest": "^4.1.8",
    "vue-eslint-parser": "^9.4.0",
    "vue-tsc": "^3.3.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "strictPeerDependencies": false,
    "autoInstallPeers": true,
    "shamefullyHoist": false,
    "packageLock": false
  }
}
